<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADders"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/chip_bg"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="v1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 1: Advertisement volume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_outer"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Adders.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advertisement volume" />

            <TextView
                style="@style/Adders.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Media volume used while an advertisement plays. Songs return to your normal volume, except while a configured fade-out is running." />

            <TextView
                android:id="@+id/percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="0%"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/slider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100"
                android:progressDrawable="@drawable/slider_track"
                android:splitTrack="false"
                android:thumb="@drawable/slider_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="0%" />

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="100%" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Volume transitions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_outer"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Adders.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volume transitions" />

            <TextView
                style="@style/Adders.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gradually change the media volume instead of jumping straight to the new level. Each transition is independent." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_inner"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Fade-in -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Adders.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="After-advertisement fade-in" />

                    <Spinner
                        android:id="@+id/fadeIn"
                        style="@style/Adders.Spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duration used to return from the advertisement volume to your normal listening volume." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <!-- Fade-out -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Adders.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Song-ending fade-out" />

                    <Spinner
                        android:id="@+id/fadeOut"
                        style="@style/Adders.Spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duration used to lower the volume during the final seconds of a song, toward the advertisement volume." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <!-- Fallback -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Adders.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fallback" />

                    <Spinner
                        android:id="@+id/fallback"
                        style="@style/Adders.Spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unidentified audio shorter than this counts as an ad." />
            </LinearLayout>

            <TextView
                style="@style/Adders.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fade-out needs the player to report the track duration and playback position. If Android or the player does not provide them, ADders cannot know the exact remaining time and waits for the normal ad/song detection instead." />
        </LinearLayout>

        <!-- Live status: 2-column tile grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/panel_inner"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App" />

                <TextView
                    android:id="@+id/app"
                    style="@style/Adders.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/panel_inner"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detection" />

                <TextView
                    android:id="@+id/state"
                    style="@style/Adders.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/panel_inner"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Adders.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Media volume" />

                <TextView
                    android:id="@+id/volume"
                    style="@style/Adders.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Empty grid cell keeps the 2-column rhythm -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Automatic volume control -->
        <Switch
            android:id="@+id/autoSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_inner"
            android:minHeight="48dp"
            android:padding="16dp"
            android:text="Automatic volume control"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track" />

        <Button
            android:id="@+id/grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_button"
            android:minHeight="48dp"
            android:text="Grant notification access"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
